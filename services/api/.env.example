APP_NAME="Segno Gebeya"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:18000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
HASH_DRIVER=argon2id
HASH_VERIFY=false
LOG_CHANNEL=single
LOG_LEVEL=info
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=13306
DB_DATABASE=segno_gebeya
DB_USERNAME=segno
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=segno_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:15173,localhost:15174,localhost:8081,127.0.0.1:15173,127.0.0.1:15174,127.0.0.1:8081
FILESYSTEM_DISK=local
CACHE_STORE=redis
QUEUE_CONNECTION=database
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=11025
MAIL_FROM_ADDRESS=development@segno.example
MAIL_FROM_NAME="Segno Gebeya"
# Local-only OTP capture. Never enable in production.
SEGNO_DEVELOPMENT_OTP=true
SEGNO_EVIDENCE_POLICY=development-review-only

